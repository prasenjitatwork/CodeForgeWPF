<Window x:Class="CodeForge.Studio.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup guide" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="../Assets/app.ico"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="14">
    <StackPanel Margin="20">
        <TextBlock Text="Set up CodeForge Studio" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"
                   Text="CodeForge runs entirely on your computer using Ollama. No account, no cloud service, and your code is never uploaded."/>

        <TextBlock Text="1. Install or locate Ollama" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Margin="0,2,0,2"
                   Text="Download it from the link below, install it and make sure it is running (it lives in the system tray). If Ollama is already installed, just start it."/>
        <TextBlock Margin="0,0,0,12"><Hyperlink x:Name="DownloadLink" NavigateUri="https://ollama.com/download" RequestNavigate="OnNavigate">https://ollama.com/download</Hyperlink></TextBlock>

        <TextBlock Text="2. Download a model" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Margin="0,2,0,4" Text="Open a terminal and run (this downloads several GB once):"/>
        <TextBox Text="{Binding PullCommand, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Padding="6" Margin="0,0,0,12"
                 AutomationProperties.AutomationId="PullCommand"/>

        <TextBlock Text="3. Check the connection" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
            <Button Content="Check connection" Command="{Binding CheckCommand}" Padding="12,4"
                    AutomationProperties.AutomationId="CheckConnection"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold"
                   AutomationProperties.AutomationId="OnboardingStatus"/>
        <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
        <TextBlock Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"
                   Text="You can reopen this guide any time with the “Setup guide” button in the sidebar. The only network traffic is to your local Ollama server."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Done" Style="{StaticResource AccentButton}" Command="{Binding FinishCommand}" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
