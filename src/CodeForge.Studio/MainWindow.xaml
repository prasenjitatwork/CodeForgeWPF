<Window x:Class="CodeForge.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CodeForge.Studio.ViewModels"
        xmlns:v="clr-namespace:CodeForge.Studio.Views"
        Title="CodeForge Studio" Width="1200" Height="780" MinWidth="760" MinHeight="480" Icon="Assets/app.ico"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="14"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewConversationCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="240" MaxWidth="560"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="{StaticResource SidebarBrush}" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="14,14,14,8">
                <Image Source="Assets/logo.png" Height="72" Margin="0,0,0,6" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Local AI coding assistant" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,10" HorizontalAlignment="Center"/>
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Button Content="💬 Chats" Command="{Binding SelectChatsTabCommand}" Margin="0,0,3,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowProjectTab}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="📂 Project" Command="{Binding SelectProjectTabCommand}" Margin="3,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowProjectTab}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>
                <Button Content="＋  New conversation" Style="{StaticResource AccentButton}"
                        Command="{Binding NewConversationCommand}"
                        Visibility="{Binding ShowChatsTab, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                     Visibility="{Binding ShowChatsTab, Converter={StaticResource BoolToVis}}"
                     IsEnabled="{Binding CanEditConversations}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ConversationItem}" Margin="8,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConversationItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:g}', Mode=OneWay}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Style="{StaticResource LinkButton}" ToolTip="Delete conversation"
                                    Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Project panel -->
            <Grid Grid.Row="1" Margin="8,0" DataContext="{Binding Project}" Grid.RowSpan="1"
                  Visibility="{Binding DataContext.ShowProjectTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="Open folder…" Command="{Binding OpenFolderCommand}" Margin="0,0,4,4" Padding="8,4"/>
                    <Button Content="Open file…" Command="{Binding OpenFileCommand}" Margin="0,0,4,4" Padding="8,4"
                            ToolTip="Open a .sln, .slnx, .csproj or pubspec.yaml"/>
                    <Button Content="⟳" Command="{Binding RefreshCommand}" Margin="0,0,4,4" Padding="8,4" ToolTip="Re-scan files"/>
                    <Button Content="Close" Command="{Binding CloseProjectCommand}" Margin="0,0,4,4" Padding="8,4"/>
                    <Button Content="Explain project" Command="{Binding ExplainProjectCommand}" Style="{StaticResource AccentButton}"
                            Margin="0,0,0,4" Padding="8,4"/>
                </WrapPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding InfoText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding InfoText}"/>
                    <TextBlock Text="{Binding Error}" Foreground="#FFB4AE" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search file names and file contents"/>
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource LinkButton}" Command="{Binding ClearSearchCommand}" Margin="4,0,0,0"/>
                </Grid>
                <Grid Grid.Row="3">
                    <TreeView ItemsSource="{Binding Roots}" Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextBrush}" SelectedItemChanged="Tree_SelectedItemChanged">
                        <TreeView.Style>
                            <Style TargetType="TreeView">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResults}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Style>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <DockPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ResultsHeader}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                        <ListBox ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SearchResultItem}">
                                    <StackPanel Background="Transparent" MouseLeftButtonUp="Result_Click" Margin="0,2">
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                        <TextBlock Text="{Binding Snippet}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
                <Border Grid.Row="4" Height="200" Margin="0,6,0,0" Background="{StaticResource CodeBgBrush}"
                        BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="6,4">
                            <TextBlock Text="{Binding PreviewTitle}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,60,0"/>
                            <Button Content="Outline" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                    Command="{Binding ShowOutlineCommand}" FontSize="11"/>
                        </Grid>
                        <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 Background="Transparent" BorderThickness="0" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>
            </Grid>
            <Button Grid.Row="2" Content="⚙  Settings" Margin="14" Command="{Binding OpenSettingsCommand}"/>
        </Grid>

        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{StaticResource BorderBrushDark}"/>

        <!-- Main area -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Padding="18,12" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="Disconnected">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="{Binding Project.Title}" ContentStringFormat="Use project context: {0}" IsChecked="{Binding Project.ContextEnabled}"
                                  IsEnabled="{Binding Project.HasProject}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                  Margin="0,0,14,0" MaxWidth="260" ToolTip="Send relevant excerpts from the open project with each question"/>
                        <TextBlock Text="Model:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="210" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                                  IsEnabled="{Binding CanEditConversations}" ToolTip="Installed Ollama models"/>
                        <Button Content="⟳ Retry" Margin="8,0,0,0" Command="{Binding RefreshConnectionCommand}"
                                ToolTip="Re-check Ollama connection"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Messages -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="18,12">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MessageViewModel}">
                                <Border x:Name="Bubble" CornerRadius="10" Padding="14,10" Margin="0,6,0,6" MaxWidth="820"
                                        HorizontalAlignment="Left" Background="{StaticResource AssistantBubbleBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding RoleLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <Button Content="⧉ Copy" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                                    FontSize="11" ToolTip="Copy message"
                                                    Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <v:MarkdownView Text="{Binding Content}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ContextNote}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasContextNote, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="Generating…" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"
                                                   Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="Bubble" Property="Background" Value="{StaticResource UserBubbleBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMessages}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="⚒" FontSize="48" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="Start a conversation" FontSize="18" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="Ask a coding question. Runs locally through Ollama." Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Error banner -->
            <Border Grid.Row="2" Background="#3A1F1F" BorderBrush="{StaticResource DangerBrush}" BorderThickness="0,1,0,1" Padding="18,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FFB4AE"/>
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource LinkButton}" Command="{Binding DismissErrorCommand}"/>
                </Grid>
            </Border>

            <!-- Input -->
            <Grid Grid.Row="3" Margin="18,10,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="160"
                         VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEditConversations}"
                         ToolTip="Enter to send, Shift+Enter for a new line">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                    <Button Content="Send" Style="{StaticResource AccentButton}" Padding="22,10" Command="{Binding SendCommand}"/>
                    <Button Content="■ Stop" Style="{StaticResource DangerButton}" Padding="22,10" Margin="0,6,0,0"
                            Command="{Binding StopCommand}" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
